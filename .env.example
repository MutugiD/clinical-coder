# Export these settings in the shell; the application does not load .env implicitly.
SCRIBE_PROVIDER=gemini
# Gemini is the sole live provider; offline mode does not require a key.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
GEMINI_TIMEOUT_SECONDS=180
# Compose extraction mode; direct CLI uses --offline instead.
SCRIBE_OFFLINE=false
# For independently started HTTP wrappers: extract, validate, resolve or knowledge.
SCRIBE_SERVICE=extract
